<theme>
  <formatVersion>7</formatVersion>
  <view ifSubset="water-particles:on" name="system,basic,detailed,video">
    <!-- Reuse one soft texture; particles stay behind the logo and game list. -->
    <image name="water-particle-01,water-particle-02,water-particle-03,water-particle-04,water-particle-06,water-particle-08,water-particle-09,water-particle-14" extra="true">
      <path>${themePath}/assets/images/ambient-glow.png</path>
      <origin>0.5 0.5</origin>
      <color>${uiTint}B3</color>
      <linearSmooth>true</linearSmooth>
      <autoFade>false</autoFade><zIndex>1.5</zIndex>
    </image>
    <!-- Start invisible; introduce one particle every two seconds, up to 8.
         Each fades in once while the drift repeats continuously. -->
    <!-- A zero width preserves circular particles on every screen ratio. -->
    <image name="water-particle-01" extra="true">
      <pos>0.227 0.331</pos><size>0 0.026</size><opacity>0</opacity>
      <storyboard repeat="forever">
        <animation property="opacity" from="0" to="0.48" begin="500" duration="3500" mode="easeInOut"/>
        <animation property="pos" from="0.227 0.331" to="0.279 0.474" duration="14000" repeat="forever" autoReverse="true" mode="easeInOut"/>
      </storyboard>
    </image>
    <image name="water-particle-02" extra="true">
      <pos>0.292 0.6365</pos><size>0 0.036</size><opacity>0</opacity>
      <storyboard repeat="forever">
        <animation property="opacity" from="0" to="0.40" begin="8500" duration="3500" mode="easeInOut"/>
        <animation property="pos" from="0.292 0.6365" to="0.2465 0.487" duration="18000" repeat="forever" autoReverse="true" mode="easeInOut"/>
      </storyboard>
    </image>
    <image name="water-particle-03" extra="true">
      <pos>0.3375 0.422</pos><size>0 0.060</size><opacity>0</opacity>
      <storyboard repeat="forever">
        <animation property="opacity" from="0" to="0.26" begin="12500" duration="3500" mode="easeInOut"/>
        <animation property="pos" from="0.3375 0.422" to="0.396 0.305" duration="22000" repeat="forever" autoReverse="true" mode="easeInOut"/>
      </storyboard>
    </image>
    <image name="water-particle-04" extra="true">
      <pos>0.4025 0.7015</pos><size>0 0.030</size><opacity>0</opacity>
      <storyboard repeat="forever">
        <animation property="opacity" from="0" to="0.50" begin="4500" duration="3500" mode="easeInOut"/>
        <animation property="pos" from="0.4025 0.7015" to="0.4545 0.539" duration="16000" repeat="forever" autoReverse="true" mode="easeInOut"/>
      </storyboard>
    </image>
    <image name="water-particle-06" extra="true">
      <pos>0.526 0.5975</pos><size>0 0.044</size><opacity>0</opacity>
      <storyboard repeat="forever">
        <animation property="opacity" from="0" to="0.34" begin="10500" duration="3500" mode="easeInOut"/>
        <animation property="pos" from="0.526 0.5975" to="0.578 0.721" duration="19000" repeat="forever" autoReverse="true" mode="easeInOut"/>
      </storyboard>
    </image>
    <image name="water-particle-08" extra="true">
      <pos>0.643 0.6755</pos><size>0 0.054</size><opacity>0</opacity>
      <storyboard repeat="forever">
        <animation property="opacity" from="0" to="0.28" begin="14500" duration="3500" mode="easeInOut"/>
        <animation property="pos" from="0.643 0.6755" to="0.5975 0.5455" duration="21000" repeat="forever" autoReverse="true" mode="easeInOut"/>
      </storyboard>
    </image>
    <image name="water-particle-09" extra="true">
      <pos>0.721 0.448</pos><size>0 0.038</size><opacity>0</opacity>
      <storyboard repeat="forever">
        <animation property="opacity" from="0" to="0.42" begin="6500" duration="3500" mode="easeInOut"/>
        <animation property="pos" from="0.721 0.448" to="0.669 0.3245" duration="17000" repeat="forever" autoReverse="true" mode="easeInOut"/>
      </storyboard>
    </image>
    <image name="water-particle-14" extra="true">
      <pos>0.773 0.2985</pos><size>0 0.028</size><opacity>0</opacity>
      <storyboard repeat="forever">
        <animation property="opacity" from="0" to="0.46" begin="2500" duration="3500" mode="easeInOut"/>
        <animation property="pos" from="0.773 0.2985" to="0.7275 0.409" duration="16500" repeat="forever" autoReverse="true" mode="easeInOut"/>
      </storyboard>
    </image>
  </view>
  <view ifSubset="water-particles:on" name="system,basic,detailed,video">
    <!-- One broad glow contracts to the center and disappears on entrance. -->
    <image name="water-intro-glow" extra="true">
      <path>${themePath}/assets/images/ambient-glow.png</path>
      <origin>0.5 0.5</origin><pos>0.5 0.5</pos><size>2.4 2.4</size>
      <color>${uiTint}FF</color>
      <opacity>0.65</opacity><autoFade>false</autoFade><zIndex>30</zIndex>
      <storyboard>
        <animation property="size" from="2.4 2.4" to="0.015 0.015" duration="750" mode="easeInOut"/>
        <animation property="opacity" from="0.65" to="0" begin="240" duration="510" mode="easeInOut"/>
      </storyboard>
    </image>
  </view>
</theme>
