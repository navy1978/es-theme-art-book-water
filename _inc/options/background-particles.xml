    </image>
    <image name="water-particle-05" extra="true">
      <pos>0.46 0.22</pos><size>0 0.080</size><opacity>0</opacity>
      <storyboard repeat="forever">
        <animation property="opacity" from="0" to="0.22" begin="24500" duration="3500" mode="easeInOut"/>
