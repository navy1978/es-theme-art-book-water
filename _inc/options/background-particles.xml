<theme>
  <formatVersion>7</formatVersion>
  <view ifSubset="water-particles:on" name="system,basic,detailed,video">
    <!-- Reuse one soft texture; particles stay behind the logo and game list. -->
    <image name="water-particle-01,water-particle-02,water-particle-03,water-particle-04,water-particle-05,water-particle-06,water-particle-07,water-particle-08,water-particle-09,water-particle-10,water-particle-11,water-particle-12,water-particle-13,water-particle-14" extra="true">
      <path>${themePath}/assets/images/ambient-glow.png</path>
      <origin>0.5 0.5</origin>
      <color>${uiTint}FF</color>
      <autoFade>false</autoFade><zIndex>1.5</zIndex>
    </image>
    <!-- Start invisible; introduce one particle every two seconds, up to 14.
         Each fades in once while the drift repeats continuously. -->
    <!-- A zero width preserves circular particles on every screen ratio. -->
    <image name="water-particle-01" extra="true">
      <pos>0.08 0.24</pos><size>0 0.026</size><opacity>0</opacity>
      <storyboard repeat="forever">
        <animation property="opacity" from="0" to="0.48" begin="500" duration="3500" mode="easeInOut"/>
        <animation property="pos" from="0.08 0.24" to="0.16 0.46" duration="14000" repeat="forever" autoReverse="true" mode="easeInOut"/>
      </storyboard>
    </image>
    <image name="water-particle-02" extra="true">
      <pos>0.18 0.71</pos><size>0 0.036</size><opacity>0</opacity>
      <storyboard repeat="forever">
        <animation property="opacity" from="0" to="0.40" begin="8500" duration="3500" mode="easeInOut"/>
        <animation property="pos" from="0.18 0.71" to="0.11 0.48" duration="18000" repeat="forever" autoReverse="true" mode="easeInOut"/>
      </storyboard>
    </image>
    <image name="water-particle-03" extra="true">
      <pos>0.25 0.38</pos><size>0 0.060</size><opacity>0</opacity>
      <storyboard repeat="forever">
        <animation property="opacity" from="0" to="0.26" begin="18500" duration="3500" mode="easeInOut"/>
