<theme>
  <formatVersion>7</formatVersion>
  <view name="system">
    <image name="water-ambient-left" extra="true">
      <path>${themePath}/assets/images/ambient-glow.png</path>
      <origin>0.5 0.5</origin><pos>0.5 0.5</pos><size>0.85 0.65</size>
      <color>${uiTint}48</color><autoFade>false</autoFade><zIndex>1</zIndex>
      <storyboard ifSubset="water-background:ambient" repeat="forever">
        <animation property="pos" from="0.5 0.5" to="0.24 0.36" duration="17000" repeat="forever" autoReverse="true" mode="easeInOut"/>
      </storyboard>
    </image>
    <image name="water-ambient-right" extra="true">
      <path>${themePath}/assets/images/ambient-glow.png</path>
      <origin>0.5 0.5</origin><pos>0.5 0.5</pos><size>0.70 0.55</size>
      <color>${uiTint}30</color><autoFade>false</autoFade><zIndex>1</zIndex>
      <storyboard ifSubset="water-background:ambient" repeat="forever">
        <animation property="pos" from="0.5 0.5" to="0.78 0.65" duration="21000" repeat="forever" autoReverse="true" mode="easeInOut"/>
      </storyboard>
    </image>
  </view>
</theme>
