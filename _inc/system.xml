<theme>
  <formatVersion>7</formatVersion>
  <view name="screen">
    <batteryIndicator name="batteryIndicator">
      <color>${uiText}</color>
      <visible ifSubset="water-colors:per-system">false</visible>
    </batteryIndicator>
    <text name="clock">
      <visible>false</visible>
    </text>
  </view>
  <view name="system" extraTransition="fade" extraTransitionSpeed="460">
    <!-- Keep ES navigation active while the extra renders the selected scene. -->
    <carousel name="systemcarousel">
      <pos>0 0</pos><size>1 1</size><origin>0 0</origin>
      <type>horizontal</type><color>00000000</color>
      <logoSize>0.01 0.01</logoSize><logoScale>1</logoScale>
      <maxLogoCount>1</maxLogoCount><defaultTransition>fade</defaultTransition>
      <transitionSpeed>460</transitionSpeed><systemInfoDelay>0</systemInfoDelay>
      <zIndex>-1</zIndex>
    </carousel>
    <image name="logo"><path>${fallbackLogo}</path><color>FFFFFF00</color></image>
    <text name="logoText"><color>FFFFFF00</color></text>
    <image name="water-background" extra="true">
      <pos>0 0</pos><size>1 1</size><path>../assets/images/white.svg</path>
      <color>${background}</color><zIndex>0</zIndex>
    </image>
    <clock name="clock-position-test" extra="static">
      <pos>0.060 0.016</pos><size>0.22 0.064</size><alignment>left</alignment><verticalAlignment>center</verticalAlignment><lineSpacing>1.5</lineSpacing><multiLine>false</multiLine>
      <fontPath>${fontBold}</fontPath><fontSize>0.034</fontSize><color>${uiText}</color><zIndex>10</zIndex>
    </clock>
    <image name="clock-icon" extra="static">
      <path>${themePath}/assets/images/clock.svg</path>
      <origin>0.5 0.5</origin><pos>0.035 0.048</pos><size>0 0.052</size>
      <color>${uiText}</color><autoFade>false</autoFade><zIndex>10</zIndex>
    </image>
    <image name="water-top-status-panel" extra="static">
      <path>${themePath}/assets/images/panel-white.png</path>
      <origin>0 0</origin><pos>0 0</pos><size>1 0.155</size>
      <tile>false</tile><color>${statusPanel}E6</color><colorEnd>${statusPanel}00</colorEnd><gradientType>vertical</gradientType><autoFade>false</autoFade><zIndex>4</zIndex>
    </image>
    <text if="${system.collection} &lt; 1 &amp;&amp; ${system.name} != 'tools' &amp;&amp; ${system.manufacturer} != '' &amp;&amp; ${system.manufacturer} != 'Various'" name="system-metadata" extra="true">
      <pos>0.12 0.21</pos><size>0.76 0.055</size><alignment>center</alignment><text>{system:manufacturer} · {system:releaseYear}</text>
      <fontPath>${fontBold}</fontPath><fontSize>0.033</fontSize><forceUppercase>true</forceUppercase><color>${uiText}</color><zIndex>10</zIndex>
    </text>
    <text name="network-ip" extra="static">
      <pos>0.72 0.092</pos><size>0.25 0.030</size><alignment>right</alignment>
      <fontPath>${fontRegular}</fontPath><fontSize>0.026</fontSize><color>${uiText}</color><zIndex>10</zIndex>
      <text>{global:ip}</text>
    </text>
    <!-- Keep the logo inside a bounded box.  This is compatible with the GLES2
         renderer used by AmberELEC handhelds even when custom shaders are not
         available in the installed EmulationStation build. -->
    <image ifSubset="water-effects:animated|still" name="water-logo" extra="true">
      <path>${fallbackLogo}</path><path>${logoPath}</path>
      <origin>0.5 0.5</origin><pos>0.5 0.40</pos>
      <maxSize>${logoDisplayMaxWidth} ${logoDisplayMaxHeight}</maxSize>
      <color>${uiTint}FF</color><autoFade>false</autoFade><zIndex>3</zIndex>
      <storyboard ifSubset="water-effects:animated" repeat="forever">
        <animation property="pos" from="0.5 0.40" to="0.5 0.385" duration="2200" repeat="forever" autoReverse="true" mode="easeInOut"/>
      </storyboard>
    </image>
    <image ifSubset="water-effects:animated|still" name="water-reflection" extra="true">
      <path>${fallbackLogo}</path><path>${logoPath}</path>
      <origin>0.5 0.5</origin><pos>0.5 0.71</pos>
      <maxSize>${logoMaxWidth} ${logoMaxHeight}</maxSize>
      <flipY>true</flipY><color>${uiTint}45</color><colorEnd>${uiTint}00</colorEnd>
      <gradientType>vertical</gradientType><zIndex>3</zIndex>
      <storyboard ifSubset="water-effects:animated" repeat="forever">
        <animation property="pos" from="0.5 0.71" to="0.5 0.70" duration="2600" repeat="forever" autoReverse="true" mode="easeInOut"/>
      </storyboard>
    </image>
    <image ifSubset="water-effects:calm" name="water-calm-horizon" extra="true">
      <path>../assets/images/horizon.svg</path><pos>0 0.43</pos><size>1 0.25</size>
      <color>${accent}55</color><zIndex>2</zIndex>
    </image>
    <image ifSubset="water-effects:calm" name="water-calm-logo" extra="true">
      <path>${fallbackLogo}</path><path>${logoPath}</path>
      <origin>0.5 0.5</origin><pos>0.5 0.40</pos><maxSize>${logoDisplayMaxWidth} ${logoDisplayMaxHeight}</maxSize>
      <color>${uiTint}FF</color><zIndex>3</zIndex>
    </image>
    <image ifSubset="water-effects:calm" name="water-calm-reflection" extra="true">
      <path>${fallbackLogo}</path><path>${logoPath}</path>
      <origin>0.5 0.5</origin><pos>0.5 0.71</pos><maxSize>${logoMaxWidth} ${logoMaxHeight}</maxSize>
      <flipY>true</flipY><color>${uiTint}45</color><colorEnd>${uiTint}00</colorEnd><gradientType>vertical</gradientType>
      <zIndex>3</zIndex>
    </image>
    <text name="water-left" extra="true">
      <pos>0.04 0.355</pos><size>0.06 0.09</size><text>‹</text><alignment>center</alignment>
      <fontPath>${fontRegular}</fontPath><fontSize>0.075</fontSize><color>${uiTint}</color><zIndex>10</zIndex>
    </text>
    <text name="water-right" extra="true">
      <pos>0.90 0.355</pos><size>0.06 0.09</size><text>›</text><alignment>center</alignment>
      <fontPath>${fontRegular}</fontPath><fontSize>0.075</fontSize><color>${uiTint}</color><zIndex>10</zIndex>
    </text>
    <text name="systemInfo">
      <visible ifSubset="water-colors:per-system">false</visible>
      <pos>0.12 0.535</pos><size>0.76 0.05</size><alignment>center</alignment>
      <fontPath>${fontRegular}</fontPath><fontSize>0.038</fontSize><color>${uiMuted}</color><zIndex>10</zIndex>
    </text>
    <text ifSubset="water-colors:per-system" name="water-game-count" extra="true">
      <pos>0.12 0.535</pos><size>0.76 0.05</size><alignment>center</alignment>
      <fontPath>${fontRegular}</fontPath><fontSize>0.038</fontSize><color>${uiMuted}</color><zIndex>10</zIndex>
      <text>{system:total} GAMES</text>
      <visible>{system:total} != 1</visible>
    </text>
    <text ifSubset="water-colors:per-system" name="water-game-count-single" extra="true">
      <pos>0.12 0.535</pos><size>0.76 0.05</size><alignment>center</alignment>
      <fontPath>${fontRegular}</fontPath><fontSize>0.038</fontSize><color>${uiMuted}</color><zIndex>10</zIndex>
      <text>1 GAME</text><visible>{system:total} == 1</visible>
    </text>
    <image name="water-help-panel" extra="static">
      <path>${themePath}/assets/images/panel-white.png</path>
      <origin>0 0</origin><pos>0 0.845</pos><size>1 0.155</size>
      <tile>false</tile><color>${statusPanel}00</color><colorEnd>${statusPanel}E6</colorEnd><gradientType>vertical</gradientType><autoFade>false</autoFade><zIndex>4</zIndex>
    </image>
    <text if="${global.cheevos.username} != ''" name="retroachievements-status" extra="static">
      <pos>0.02 0.092</pos><size>0.35 0.030</size><alignment>left</alignment>
      <fontPath>${fontRegular}</fontPath><fontSize>0.026</fontSize><color>${uiText}</color><zIndex>10</zIndex>
      <text>★ RA - {global:cheevosUser}</text>
    </text>
  </view>
  <view ifSubset="water-colors:per-system" name="system,basic,detailed,video">
    <networkIcon name="water-network">
      <networkIcon>:/network.svg</networkIcon><planemodeIcon>:/plane.svg</planemodeIcon>
      <origin>0.5 0.5</origin><pos>0.825 0.048</pos><size>0 0.052</size><color>${uiText}</color><zIndex>10</zIndex>
    </networkIcon>
    <batteryIcon name="water-battery">
      <origin>0.5 0.5</origin><pos>0.880 0.048</pos><size>0 0.056</size><color>${uiText}</color><zIndex>10</zIndex>
    </batteryIcon>
    <batteryText name="water-battery-percent">
      <pos>0.908 0.016</pos><size>0.068 0.064</size><alignment>right</alignment><verticalAlignment>center</verticalAlignment>
      <fontPath>${fontBold}</fontPath><fontSize>0.034</fontSize><color>${uiText}</color><zIndex>10</zIndex>
    </batteryText>
  </view>
  <view name="system,basic,detailed,video">
    <helpsystem name="help">
      <pos>0.04 0.95</pos><origin>0 0.5</origin><fontPath>${fontRegular}</fontPath>
      <fontSize>0.036</fontSize><textColor>${uiText}</textColor><iconColor>${uiText}</iconColor>
    </helpsystem>
  </view>
  <!-- Per-system colors stay in the central scene; status chrome stays neutral and fixed. -->
  <view ifSubset="water-colors:per-system" name="system">
    <clock name="clock-position-test" extra="static"><color>FFFFFF</color></clock>
    <image name="clock-icon" extra="static"><color>FFFFFF</color></image>
    <text name="network-ip" extra="static"><color>FFFFFF</color></text>
    <text if="${global.cheevos.username} != ''" name="retroachievements-status" extra="static"><color>FFFFFF</color></text>
    <image name="water-top-status-panel" extra="static"><color>252525E6</color><colorEnd>25252500</colorEnd></image>
    <image name="water-help-panel" extra="static"><color>25252500</color><colorEnd>252525E6</colorEnd></image>
  </view>
  <view ifSubset="water-colors:per-system" name="system,basic,detailed,video">
    <networkIcon name="water-network" extra="static"><color>FFFFFF</color></networkIcon>
    <batteryIcon name="water-battery" extra="static"><color>FFFFFF</color></batteryIcon>
    <batteryText name="water-battery-percent" extra="static"><color>FFFFFF</color></batteryText>
    <helpsystem name="help"><textColor>FFFFFF</textColor><iconColor>FFFFFF</iconColor></helpsystem>
  </view>
  <!-- RG552: separate native components avoid the global indicator's icon overlap. -->
  <view if="${screen.width} &gt; 1000" name="screen">
    <batteryIndicator name="batteryIndicator"><visible>false</visible></batteryIndicator>
  </view>
  <view if="${screen.width} &gt; 1000" name="system,basic,detailed,video">
    <networkIcon name="water-network" extra="static">
      <networkIcon>:/network.svg</networkIcon><planemodeIcon>:/plane.svg</planemodeIcon>
      <origin>0.5 0.5</origin><pos>0.825 0.048</pos><size>0 0.052</size><color>${uiText}</color><zIndex>10</zIndex>
    </networkIcon>
    <batteryIcon name="water-battery" extra="static">
      <origin>0.5 0.5</origin><pos>0.880 0.048</pos><size>0 0.056</size><color>${uiText}</color><zIndex>10</zIndex>
    </batteryIcon>
    <batteryText name="water-battery-percent" extra="static">
      <pos>0.908 0.016</pos><size>0.068 0.064</size><alignment>right</alignment><verticalAlignment>center</verticalAlignment>
      <fontPath>${fontBold}</fontPath><fontSize>0.034</fontSize><color>${uiText}</color><zIndex>10</zIndex>
    </batteryText>
  </view>
  <view if="${screen.width} &gt; 1000" ifSubset="water-colors:per-system" name="system,basic,detailed,video">
    <networkIcon name="water-network" extra="static"><color>FFFFFF</color></networkIcon>
    <batteryIcon name="water-battery" extra="static"><color>FFFFFF</color></batteryIcon>
    <batteryText name="water-battery-percent" extra="static"><color>FFFFFF</color></batteryText>
  </view>
  <!-- RG552: keep the same visual grid and hierarchy used by the smaller handhelds. -->
  <view if="${screen.width} &gt; 1000" name="system">
    <clock name="clock-position-test" extra="static">
      <pos>0.060 0.016</pos><size>0.22 0.064</size><alignment>left</alignment><verticalAlignment>center</verticalAlignment>
      <fontPath>${fontBold}</fontPath><fontSize>0.034</fontSize>
    </clock>
    <text name="network-ip" extra="static">
      <pos>0.72 0.092</pos><size>0.25 0.030</size><alignment>right</alignment><verticalAlignment>center</verticalAlignment>
      <fontPath>${fontRegular}</fontPath><fontSize>0.026</fontSize>
    </text>
    <text name="retroachievements-status" extra="static" if="${global.cheevos.username} != ''">
      <pos>0.02 0.092</pos><size>0.35 0.030</size><alignment>left</alignment><verticalAlignment>center</verticalAlignment>
      <fontPath>${fontRegular}</fontPath><fontSize>0.026</fontSize>
    </text>
  </view>
</theme>
